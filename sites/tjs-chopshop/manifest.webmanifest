{
  "name": "TJ's ChopShop",
  "short_name": "ChopShop",
  "description": "TJ's ChopShop, a barbershop at 1521 17th St in Columbus, Indiana. Book your cut, see the menu, find the shop.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#F4EBDD",
  "theme_color": "#831D2C",
  "categories": ["lifestyle", "beauty"],
  "icons": [
    { "src": "app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Cuts and prices", "short_name": "Menu", "url": "./#menu", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Find the shop", "short_name": "Visit", "url": "./#visit", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] }
  ]
}
